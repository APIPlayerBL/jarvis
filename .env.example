# --- секреты ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Прямой DeepSeek (по умолчанию) или ключ агрегатора AITUNNEL.
# Основная модель — самая дешёвая из подходящих (9/9 на тестах команд):
#   DEEPSEEK_BASE_URL=https://api.aitunnel.ru/v1
#   DEEPSEEK_MODEL=mimo-v2.6-flash
#   DEEPSEEK_FALLBACK_MODEL=deepseek-v4.1-flash-1017   # резерв на том же ключе
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Отключить рассуждение у «думающих» моделей (первый звук вдвое быстрее):
# JARVIS_BRAIN_EXTRA={"reasoning": {"effort": "none"}}
# Цены провайдера, ₽ за 1M токенов — нужны только для учёта расхода в логах
# (Jarvis сам считает, сколько стоила каждая команда и сеанс).
#   deepseek-v4.1-flash-1017 = 0.6 / 120   mimo-v2.6-flash = 0.56 / 56
#   mistral-nemo = 3.8 / 6                 qwen3.7-flash = 1.2 / 26
# JARVIS_PRICE_IN=0.6
# JARVIS_PRICE_OUT=120
# YandexGPT — резерв без VPN: ключ сервисного аккаунта + каталог.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt-lite   # или yandexgpt (умнее, дороже)

# --- голос ---
# auto: Piper (локально) -> edge-tts (облако) -> SAPI (офлайн-резерв)
# Установка Piper: python setup_tts.py --pull
# JARVIS_TTS_ENGINE=auto
# JARVIS_PIPER_EXE=C:\jarvis\assets\piper\bin\piper.exe
# JARVIS_PIPER_MODEL=C:\jarvis\assets\piper\voices\ru_RU-dmitri-medium.onnx
# JARVIS_EDGE_VOICE=ru-RU-DmitryNeural
# JARVIS_TTS_RATE=180
# JARVIS_STREAM_TTS=1          # озвучивать по фразам, не дожидаясь конца ответа

# --- контекст и инструменты ---
# JARVIS_CONTEXT_TURNS=2       # сколько прошлых реплик помнить (0 — выключить)
# JARVIS_TOOLS_MAX=8           # сколько схем инструментов уходит в запрос (0 — все)
# JARVIS_TOOLS_RETRY=1         # повтор с полным набором, если модель не вызвала функцию
# JARVIS_CHAT_FASTPATH=1       # болталка без инструментов и потоково
# JARVIS_GUARD=1               # внешний текст (страницы, OCR) только как данные

# --- экран ---
# JARVIS_OCR_WINDOW=1          # OCR только активного окна (приватнее и быстрее)
# JARVIS_OCR_CACHE_SEC=20      # кэш OCR того же окна
# JARVIS_OCR_MAX_CHARS=6000

# --- микрофон: индекс (0,1,2...) или часть имени ---
# JARVIS_MIC=1
# Чувствительность: 1.0 штатная, 2.0 — для тихой речи
# JARVIS_SENSITIVITY=1.0

# --- wake word (через запятую) ---
# JARVIS_WAKE_WORDS=джарвис,жарвис,джейвис

# --- STT ---
# JARVIS_STT_DEVICE=cpu
# JARVIS_STT_COMPUTE=int8
# JARVIS_WHISPER_GAME=small
# JARVIS_WHISPER_DESKTOP=small
# JARVIS_CPU_THREADS=4
# Лёгкая модель только для wake word (пусто — выключить)
# JARVIS_STT_WAKE=tiny
# Через сколько секунд простоя выгружать тяжёлую модель из RAM (0 — никогда)
# JARVIS_STT_IDLE_UNLOAD=900

# --- паузы ---
# JARVIS_SILENCE_SEC=0.7
# JARVIS_MAX_SECONDS=8
# JARVIS_WAIT_TIMEOUT=10

# --- мозг ---
# JARVIS_BRAIN_TIMEOUT=15
# JARVIS_BRAIN_MAX_TOKENS=400

# --- сеть без VPN ---
# HTTP-прокси (например, локальный порт VPN-клиента) или socks5://...
# JARVIS_PROXY=http://127.0.0.1:2080
# JARVIS_BROWSER_PROXY=
# Релей (Cloudflare Worker/VPS): пути /groq и /openrouter
# JARVIS_GROQ_BASE_URL=https://<worker>.workers.dev/groq
# JARVIS_OPENROUTER_BASE_URL=https://<worker>.workers.dev/openrouter
# JARVIS_RELAY_TOKEN=

# --- локальная LLM без интернета и без GPU ---
# JARVIS_LOCAL_LLM=1
# JARVIS_LOCAL_LLM_FIRST=1
# JARVIS_LOCAL_ONLY=1   # полностью запретить облачные LLM
# JARVIS_LOCAL_LLM_MODEL=qwen2.5:7b
# JARVIS_OLLAMA_NUM_GPU=0
# JARVIS_OLLAMA_NUM_CTX=16384
# JARVIS_OLLAMA_THREADS=10
# JARVIS_NO_GPU=1

# --- «не мешать компьютеру» ---
# JARVIS_LOW_PRIORITY=1     # пониженный приоритет процесса (игры получают CPU первыми)
# JARVIS_ECO_MODE=0         # EcoQoS (Win11): энергоэффективные ядра, может добавить задержку
# JARVIS_UI_FPS_BACKGROUND=4  # кадров/с для анимации, когда окно не в фокусе
# JARVIS_COMPACT_TOPMOST=1    # мини-режим держится поверх других окон

# --- звук ---
# Одно устройство вывода для речи и музыки (пусто — системное).
# Список: python main.py --list-devices (строка со «*» — текущее).
# JARVIS_AUDIO_OUTPUT=27            # или часть имени: Headphones
# JARVIS_AUDIO_PEAK=0.9             # лимитер: выше 1.0 — клиппинг и треск
# JARVIS_AUDIO_DUCK=0.25            # музыка приглушается на время речи

# --- отладка ---
# JARVIS_DRY_RUN=1
# JARVIS_AUTO_CONFIRM=1   # НЕ включать в обычной работе: отключает подтверждение

# --- браузер и формы ---
# main: всё в твоём браузере (вкладки в уже открытом окне).
# managed: отдельное окно Playwright (только для автоматизации форм).
# JARVIS_BROWSER_MODE=main
# Подключение к основному браузеру для чтения/кликов: запусти Edge/Chrome с
# --remote-debugging-port=9222, тогда Jarvis работает в твоих вкладках.
# JARVIS_BROWSER_CDP=http://127.0.0.1:9222
# Чем заменить YouTube, если он не резолвится: yandex | vk | google | none
# JARVIS_VIDEO_FALLBACK=yandex

# --- музыка ---
# Папка с локальными треками: такие файлы Jarvis играет сам, мгновенно.
# JARVIS_MUSIC_DIR=C:\Users\ivan\Music
# Где искать, если файла нет: yandex | vk | zvuk | youtube | auto | none
# JARVIS_MUSIC_WEB=yandex
# Авто-воспроизведение в веб-сервисе без видимого окна (python setup_music.py)
# JARVIS_MUSIC_AUTOPLAY=0
# Играть 30-секундные превью из открытого каталога без логина и браузера
# JARVIS_MUSIC_ONLINE=1
# JARVIS_MUSIC_CACHE_FILES=60
# JARVIS_USER_NAME=
# JARVIS_USER_EMAIL=
# JARVIS_BROWSER_HEADLESS=0
# JARVIS_DESKTOP_CONFIRM=1
# JARVIS_AGENT_MAX_STEPS=5
